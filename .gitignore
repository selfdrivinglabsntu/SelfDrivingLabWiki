# dependencies
node_modules/
# NOTE: vendor/ (three.js, GSAP) is intentionally NOT ignored — those files
# are loaded directly by index.html at runtime and must be committed, or the
# site breaks for anyone who isn't the machine that originally downloaded them.

# build output
dist/
.cache/

# env / secrets
.env
.env.*
!.env.example

# logs
*.log
npm-debug.log*

# editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# claude code (local-machine config, not part of the site)
.claude/
settings.local.json

#large files
assets/hero.mp4

# master media kept out of the published site (never drop this folder to Netlify)
_originals/
